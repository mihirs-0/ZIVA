# ZIVA provider credentials. Copy to .env and fill in what you have.
# Keys are read only from the environment; models whose key is missing are
# skipped gracefully. Never commit .env.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# Optional external astronomy validation (auditing the local backend only;
# everything works without these -- see docs/methodology.md).
TIMEANDDATE_ACCESSKEY=
TIMEANDDATE_SECRETKEY=
